///|
/// v4 LUT（`mAB ` / `mBA `）测试的金标数据。
///
/// **本文件由 `tools/gen_v4lut_golden.py` 自动生成，请勿手工编辑。**
///
/// 参考实现：lcms2（经 Pillow 的 `ImageCms`），样本 profile 为
/// `testdata/test4.icc`（ICC v4.2，四个 LUT tag 均为 v4 类型）。
///
/// - A2B 方向：`RGB -> LAB`，8 位；
/// - B2A 方向：`RGB -> RGB` 组合变换（内部先 A2B 再 B2A），8 位。
///
/// B2A 之所以不直接以 `LAB` 模式输入，是因为 lcms2 的 8 位 Lab 输入格式器
/// 会给送进 CLUT 的坐标加一个偏移（近黑处约 8/255，用恒等探针 profile 实测），
/// 直接对拍会把该偏移记成本库的误差。
///
/// Pillow 的 LAB 模式约定：L 通道 0..255 映射 0..100，a/b 通道 0..255 映射 -128..127。

///|
/// A2B 金标：设备 RGB（0..255）+ 期望的 8 位 Lab。
pub struct V4A2BCase {
  r : Int32
  g : Int32
  b : Int32
  lp : Int32
  ap : Int32
  bp : Int32
}

///|
/// B2A 金标：设备 RGB（0..255）经 PCS 后再回到设备 RGB（0..255）。
pub struct V4B2ACase {
  r : Int32
  g : Int32
  b : Int32
  out_r : Int32
  out_g : Int32
  out_b : Int32
}

